rules_version = '2';

// Règles de la base Firestore de « Mes rendez-vous ».
// À coller dans la console Firebase : Firestore > Règles > Publier.
// Seul le compte de la famille (UID ci-dessous) peut lire ou écrire ; tout le reste est refusé.
service cloud.firestore {
  match /databases/{database}/documents {

    function estLaFamille() {
      return request.auth != null && request.auth.uid == '6VzcdhcIQZdUJgHNv4guZnAY0vj2';
    }

    // Un document par rendez-vous. « deleted » marque un rendez-vous supprimé (pour les autres appareils).
    match /rdv/{id} {
      allow read, delete: if estLaFamille();
      allow create, update: if estLaFamille()
        && id.size() <= 64
        && request.resource.data.keys().hasOnly(
             ['id', 'date', 'time', 'title', 'said', 'createdAt', 'note', 'updatedAt', 'deleted'])
        && request.resource.data.id == id;
    }
  }
}
